diff --git a/subsys/bluetooth/controller/ll_sw/ull_internal.h b/subsys/bluetooth/controller/ll_sw/ull_internal.h
index 2f29fc2e..4c3ad2cf 100644
--- a/subsys/bluetooth/controller/ll_sw/ull_internal.h
+++ b/subsys/bluetooth/controller/ll_sw/ull_internal.h
@@ -11,8 +11,20 @@
 #if defined(CONFIG_BT_CTLR_CONN_INTERVAL_LOW_LATENCY)
 #define CONN_INTERVAL_MIN(x) (0U)
 #else /* !CONFIG_BT_CTLR_CONN_INTERVAL_LOW_LATENCY */
-/* Bluetooth defined CPR Interval Minimum (7.5ms) */
-#define CONN_INTERVAL_MIN(x) (6U)
+/* Bluetooth defined CPR Interval Minimum (7.5ms).
+ *
+ * Joypad OS: runtime value, not a constant. A Nintendo Switch 2 drives a 5 ms
+ * connection interval (4 units), below the 7.5 ms minimum, so emulating a Pro
+ * Controller 2 needs this lowered -- but this header is shared by BOTH roles,
+ * and lowering it unconditionally also loosened the CENTRAL path. That made the
+ * link layer assert (reason 0xB7 -> NVIC_SystemReset) while connecting to an
+ * ordinary BLE controller. Switch 2 output and the BLE central are never needed
+ * at the same time (switch2_ble_late_init latches the central's scan off), so
+ * only that mode lowers it; every other mode keeps the spec floor.
+ * Defined in nrf/src/main.c.
+ */
+extern unsigned char joypad_le_interval_min;
+#define CONN_INTERVAL_MIN(x) (joypad_le_interval_min)
 #endif /* !CONFIG_BT_CTLR_CONN_INTERVAL_LOW_LATENCY */
 #else /* CONFIG_BT_CTLR_USER_CPR_INTERVAL_MIN */
 /* Proprietary user defined CPR Interval Minimum */
